{
  "schemaVersion": 1,
  "updated": "2026-09-23",
  "statuses": [
    "auto",
    "verified",
    "manual",
    "verification_required",
    "fatal"
  ],
  "requiredCollections": [
    "characters",
    "supports",
    "skills",
    "support_events",
    "courses",
    "support_hints",
    "skill_icon_overrides"
  ],
  "rules": {
    "duplicateCanonicalId": "fatal",
    "missingReferencedSkill": "fatal",
    "missingSupportId": "fatal",
    "iconIdZeroOrNull": "verification_required",
    "verifiedOverwrite": "blocked",
    "manifestShaMismatch": "fatal",
    "unknownEnumOrType": "verification_required",
    "massDeletion": {
      "status": "fatal",
      "removedCountGte": 10,
      "removedRatioGte": 0.02
    }
  },
  "fallback": {
    "validationPass": "staging_to_current",
    "verificationRequired": "keep_previous_verified_and_queue",
    "fatal": "keep_current_and_block_new_dataset"
  }
}
